{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launch-wellkepthabitat",
  "main": "worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "TWKH_DB",
      "database_name": "twkh-launch",
      "database_id": "6374dd0c-91ca-44b2-a628-c1e6bf16a724"
    }
  ]
}
